    "label.text.pm251hour-explainer" : {
      "comment" : "Inhalable fine particulate matter that is generally 2.5 micrometers and smaller. Use the 1-hour PM2.5 rating for immediate activities.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhalable fine particulate matter that is generally 2.5 micrometers and smaller. Use the 1-hour PM2.5 rating for immediate activities."
          }
        }
      }
    },
    "label.text.psi-description" : {
      "comment" : "PSI is a composite index calculated from PM10, PM2.5, O3, CO, NO2, and SO2. A sub-index is calculated for each pollutant per region and the highest value is used as the overall PSI for that region. Use the 24-hour PSI to plan next-day outdoor activities.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PSI is a composite index calculated from PM10, PM2.5, O₃, CO, NO₂, and SO₂. A sub-index is calculated for each pollutant per region and the highest value is used as the overall PSI for that region. Use the 24-hour PSI to plan next-day outdoor activities."
          }
        }
      }
    },
    "label.text.psi-explainer" : {
      "comment" : "Pollutant Standards Index composed of PM10, PM2.5, O3, CO, NO2, and SO2. Use the 24-hour PSI rating for next day activities.",
