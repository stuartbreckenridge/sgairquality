    "label.text.co-description" : {
      "comment" : "Carbon monoxide is a colourless, odourless gas produced by incomplete combustion. High levels reduce the blood's ability to carry oxygen. Measured as an 8-hour maximum.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carbon monoxide is a colourless, odourless gas produced by incomplete combustion. High levels reduce the blood's ability to carry oxygen. Measured as an 8-hour maximum."
