    "label.text.computation-description" : {
      "comment" : "For each of the six pollutants, a sub-index is calculated by linearly interpolating the measured concentration against a set of breakpoints. The overall PSI is the highest sub-index value across all pollutants.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For each of the six pollutants, a sub-index is calculated by linearly interpolating the measured concentration against a set of breakpoints. The overall PSI is the highest sub-index value across all pollutants."
          }
        }
      }
    },
    "label.text.computation-footer" : {
      "comment" : "Source: National Environment Agency, Singapore (March 2014).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
