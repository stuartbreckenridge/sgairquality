        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pollutant Standards Index composed of PM10, PM2.5, O3, CO, NO2, and SO2. Use the 24-hour PSI rating for next day activities."
          }
        }
      }
    },
