    "label.text.pm25-description" : {
      "comment" : "PM2.5 refers to inhalable fine particulate matter 2.5 micrometres and smaller. These particles can penetrate deep into the lungs. Use the 1-hour PM2.5 reading to decide on immediate outdoor activities.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM2.5 refers to inhalable fine particulate matter 2.5 micrometres and smaller. These particles can penetrate deep into the lungs. Use the 1-hour PM2.5 reading to decide on immediate outdoor activities."
          }
        }
      }
    },
