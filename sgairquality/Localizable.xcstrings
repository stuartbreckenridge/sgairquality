    "label.text.pm10-description" : {
      "comment" : "PM10 refers to inhalable particulate matter 10 micrometres and smaller. These particles include dust, pollen, and mould spores and can irritate the eyes, nose, and throat.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM10 refers to inhalable particulate matter 10 micrometres and smaller. These particles include dust, pollen, and mould spores and can irritate the eyes, nose, and throat."
          }
        }
      }
    },
    "label.text.pm10-explainer" : {
      "comment" : "Inhalable particulate matter that is generally 10 micrometers and smaller.",
